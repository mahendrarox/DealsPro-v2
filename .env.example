# Copy to .env.local. NEVER commit a real value — .env* is gitignored.
# Secrets live in Vercel per environment, split staging vs production.

# Required. Exactly "staging" or "production". No default, no inference
# from NODE_ENV: a built Next.js app sets NODE_ENV=production in staging
# too, so using it would misclassify the environment.
DEALSPRO_ENV=staging

# Required. Must be sk_test_ in staging and sk_live_ in production.
# Startup refuses a live key in staging — that is the no-real-money gate.
STRIPE_SECRET_KEY=sk_test_replace_me

# Required. Staging and production must be DIFFERENT Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=https://yourstagingref.supabase.co
# The other environment's project ref, so startup can prove they differ.
DEALSPRO_PRODUCTION_SUPABASE_REF=yourproductionref

# Optional. SMS is OFF unless this is exactly "true" AND the environment
# is staging. Production sending is refused outright by this skeleton.
# DEALSPRO_ALLOW_SMS=true
